import { Button, ListView, HorizontalBox, VerticalBox } from "std-widgets.slint";

export struct JobRow {
    id: int,
    descricao: string,
    progresso: int,   // 0-100
    estado: string,   // "executando" | "concluído" | "erro: ..." | "cancelado"
}

export component JobsPanel inherits Rectangle {
    in property <[JobRow]> jobs;
    callback cancelar(int);

    height: jobs.length == 0 ? 0px : min(jobs.length, 3) * 44px + 8px;
    background: #00000010;

    ListView {
        for job in root.jobs: HorizontalBox {
            height: 44px;
            Text { text: job.descricao; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
            Rectangle {
                width: 180px; height: 10px; border-radius: 5px; background: #00000020;
                Rectangle {
                    x: 0; height: parent.height; border-radius: 5px;
                    width: parent.width * job.progresso / 100;
                    background: #3b82f6;
                }
            }
            Text { text: job.estado; vertical-alignment: center; width: 110px; }
            if job.estado == "executando": Button {
                text: "✕"; width: 32px;
                clicked => { root.cancelar(job.id); }
            }
        }
    }
}
